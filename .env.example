# =========================================================================
# Doce Encanto — Environment configuration
# Copy to .env and adjust as needed. Never commit the .env file.
# =========================================================================

# --- Mode ---------------------------------------------------------------
# DEMO_MODE=true  -> all providers are simulated (Pix fake, console email,
#                    fake WhatsApp). Runs 100% offline. This is the public
#                    link mode.
# DEMO_MODE=false -> real providers: AbacatePay (Pix real) + Resend (email).
#                    Used in closing calls so the client pays a real R$ 1,00
#                    Pix and sees the order status change live.
DEMO_MODE=true

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/doce_encanto

# --- Admin --------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=demo1234
JWT_SECRET=change-me-in-production-please

# --- AbacatePay (only when DEMO_MODE=false) ----------------------------
# Get your dev/prod key at https://app.abacatepay.com
# Dev keys and prod keys use the SAME code path — just swap the key.
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
# Used to build the webhook callback URL registered at AbacatePay.
PUBLIC_BASE_URL=http://localhost:8000

# --- Resend (only when DEMO_MODE=false) --------------------------------
RESEND_API_KEY=
EMAIL_FROM=pedidos@doceencanto.demo

# --- Scheduling ---------------------------------------------------------
MIN_LEAD_TIME_HOURS=24
SLOT_CAPACITY=5
DAYS_AHEAD=14